rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isServerWrite() {
      return false;
    }

    match /league_schedules/{scheduleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isServerWrite();

      match /match_days/{dateKey} {
        allow read: if true;
        allow create, update, delete: if isAdmin() || isServerWrite();
      }
    }

    match /rooms/{roomId} {
      // room 문서는 클라이언트가 단건 구독한다.
      // 전체 rooms 컬렉션 나열은 막고, 개별 room id를 아는 경우에만 get 허용.
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin() || isServerWrite();

      match /teams/{teamId} {
        allow get, list: if true;
        allow create, update, delete: if isAdmin() || isServerWrite();
      }

      match /players/{playerId} {
        allow get, list: if true;
        allow create, update, delete: if isAdmin() || isServerWrite();
      }

      match /messages/{messageId} {
        allow get, list: if true;
        allow create, update, delete: if isAdmin() || isServerWrite();
      }

      match /bids/{bidId} {
        allow get, list: if true;
        allow create, update, delete: if isAdmin() || isServerWrite();
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /room_auth_secrets/{roomId} {
      allow read, write: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /auction_archives/{archiveId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isServerWrite();
    }

    match /hall_of_fame/{entryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isServerWrite();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
