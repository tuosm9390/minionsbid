rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isServerWrite() {
      return false;
    }

    match /league_schedules/{scheduleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isServerWrite();

      match /match_days/{dateKey} {
        allow read: if true;
        allow create, update, delete: if isAdmin() || isServerWrite();
      }
    }

    // ── 입찰 검증 함수 ──
    // LEADER가 클라이언트에서 직접 입찰할 때 Firestore 보안 규칙으로 검증
    function isBidUpdate(roomId) {
      let auth = request.auth;
      let before = resource.data;
      let after = request.resource.data;
      let newBid = after.active_bid;

      return auth != null
        // 인증된 LEADER만 허용
        && auth.token.role == 'LEADER'
        && auth.token.roomId == roomId
        // 허용된 필드만 변경 가능
        && after.diff(before).affectedKeys().hasOnly(['active_bid', 'timer_ends_at', 'auction_revision'])
        // 경매가 진행 중이어야 함
        && before.current_player_id != null
        && before.timer_ends_at > request.time
        // 입찰 데이터 구조 검증
        && newBid.player_id == before.current_player_id
        && newBid.team_id == auth.token.teamId
        && newBid.amount is int
        && newBid.amount > 0
        // 현재 입찰보다 높아야 함
        && (before.active_bid == null || newBid.amount > before.active_bid.amount)
        // 자기 팀이 최고 입찰자일 때 재입찰 불가
        && (before.active_bid == null || before.active_bid.team_id != auth.token.teamId)
        // revision 정확히 +1
        && after.auction_revision == before.auction_revision + 1
        // 남은 시간이 8초 이하인 경우에만 입찰 시점 기준 8초 후로 타이머 갱신 허용
        && isValidDirectBidTimerUpdate(before, after)
        // 팀 포인트 잔액 >= 입찰액
        && get(/databases/$(database)/documents/rooms/$(roomId)/teams/$(auth.token.teamId)).data.point_balance >= newBid.amount;
    }

    function isBidHistoryCreate(roomId) {
      let auth = request.auth;
      let data = request.resource.data;
      return auth != null
        && auth.token.role == 'LEADER'
        && auth.token.roomId == roomId
        && data.team_id == auth.token.teamId
        && data.amount is int
        && data.amount > 0;
    }

    function isValidDirectBidTimerUpdate(before, after) {
      // 1. 타이머를 갱신하지 않는 경우 (남은 시간이 8초 초과일 때 권장)
      return after.timer_ends_at == before.timer_ends_at
        || (
          // 2. 타이머를 갱신하는 경우: 남은 시간이 8초 이하일 때만 허용
          before.timer_ends_at <= request.time + duration.value(8, 's')
          // 갱신 시 새로운 종료 시간은 현재 시간(입찰 시점) 기준 8초여야 함 (오차 범위 5~11초 허용)
          && after.timer_ends_at >= request.time + duration.value(5, 's')
          && after.timer_ends_at <= request.time + duration.value(11, 's')
        );
    }

    match /rooms/{roomId} {
      // room 문서는 클라이언트가 단건 구독한다.
      // 전체 rooms 컬렉션 나열은 막고, 개별 room id를 아는 경우에만 get 허용.
      allow get: if true;
      allow list: if false;
      allow create, delete: if isAdmin() || isServerWrite();
      // 업데이트: 서버/관리자 또는 유효한 입찰
      allow update: if isAdmin() || isServerWrite() || isBidUpdate(roomId);

      match /teams/{teamId} {
        allow get, list: if true;
        allow create, update, delete: if isAdmin() || isServerWrite();
      }

      match /players/{playerId} {
        allow get, list: if true;
        allow create, update, delete: if isAdmin() || isServerWrite();
      }

      match /messages/{messageId} {
        allow get, list: if true;
        allow create, update, delete: if isAdmin() || isServerWrite();
      }

      match /bids/{bidId} {
        allow get, list: if true;
        // LEADER가 입찰 기록을 직접 생성할 수 있도록 허용
        allow create: if isAdmin() || isServerWrite() || isBidHistoryCreate(roomId);
        allow update, delete: if isAdmin() || isServerWrite();
      }

      match /sealed_bid_rounds/{roundId} {
        // 비공개 입찰 제출 금액과 제출 여부는 공개 전까지 클라이언트가 직접 읽거나 쓰지 않는다.
        // 제출/집계/공개는 Firebase Admin SDK를 사용하는 Server Action 전용 경로다.
        allow read, write: if false;

        match /submissions/{teamId} {
          allow read, write: if false;
        }
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /room_auth_secrets/{roomId} {
      allow read, write: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /auction_archives/{archiveId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isServerWrite();
    }

    match /hall_of_fame/{entryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isServerWrite();
    }

    match /timerLabs/{labId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() || isServerWrite();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
