{
  "name": "league-auction",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e:auction": "node ./scripts/run_auction_e2e.js",
    "test:e2e:auction:8leaders": "playwright test playwright/auction-eight-leaders-visual.spec.ts --project=chromium --workers=1",
    "test:e2e:auction:8leaders:headed": "playwright test playwright/auction-eight-leaders-visual.spec.ts --project=chromium --workers=1 --headed",
    "test:e2e:auction:8leaders:debug": "playwright test playwright/auction-eight-leaders-visual.spec.ts --project=chromium --debug",
    "test:e2e:multi-pc": "playwright test playwright/auction-multi-pc.spec.ts --project=chromium",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:room-auth-secrets": "node scripts/audit_room_auth_secrets.js",
    "smoke:room-rules": "node scripts/smoke_room_rules.js",
    "migrate:room-auth-secrets:dry-run": "node scripts/migrate_room_auth_secrets.js",
    "migrate:room-auth-secrets": "node scripts/migrate_room_auth_secrets.js --write",
    "seed:archive-json": "node scripts/seed_archive_from_json.js",
    "seed:hof-json": "node scripts/seed_hall_of_fame_from_json.js",
    "delete:hof-entry": "node scripts/delete_hall_of_fame_entry.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.7.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.575.0",
    "motion": "^12.38.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.0.0",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^28.1.0",
    "playwright": "^1.58.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.0.0"
  }
