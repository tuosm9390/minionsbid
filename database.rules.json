{
  "rules": {
    "presence": {
      "$roomId": {
        ".read": true,
        "$sessionId": {
          ".write": "auth != null && auth.uid === $sessionId && (newData.val() == null || newData.child('role').val() === 'LEADER' || newData.child('role').val() === 'ORGANIZER')"
        }
      }
    },
    "signals": {
      "$roomId": {
        ".read": true,
        ".write": false
      }
    },
    "timerLabSignals": {
      "$labId": {
        ".read": true,
        ".write": false
      }
    },
    "bids": {
      "$roomId": {
        ".read": "auth != null",
        ".write": false
      }
    }
  }
}
